# AegisAgent optional local configuration.
# Copy this file to .env and fill in values only on your own machine.
# Never commit real API keys.

# LLM used by AegisAgent itself for optional static audit, BuildPlan hints,
# dynamic attack planning, and report explanation.
SANDBOX_LLM_PROVIDER=openai-compatible
SANDBOX_LLM_BASE_URL=https://api.example.com/v1
SANDBOX_LLM_MODEL=your-model-name
SANDBOX_LLM_API_KEY=your-sandbox-llm-key
SANDBOX_LLM_ROLE=audit

# Runtime credentials for the untrusted agent under test.
# Leave these blank for fake-environment-only testing.
SANDBOX_RUNTIME_OPENAI_API_KEY=
SANDBOX_RUNTIME_OPENAI_API_BASE_URL=https://api.openai.com/v1
SANDBOX_RUNTIME_OPENAI_BASE_URL=https://api.openai.com/v1
SANDBOX_RUNTIME_MODEL_NAME=

SANDBOX_RUNTIME_SILICONFLOW_API_KEY=
SANDBOX_RUNTIME_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SANDBOX_RUNTIME_SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# auto: sandbox-private network unless runtime credentials require bridge.
# sandbox: fake environment only.
# none: no runtime network.
# bridge: allow public network for real API-key conversation tests.
SANDBOX_RUNTIME_NETWORK=auto

# Optional managed fake-real service presets:
# mailhog, mailpit, minio, gitea, playwright
AGENT_SANDBOX_REAL_SERVICES=
